# Backend base URL used by the Next.js rewrite proxy (/api/* -> backend/*).
# The browser only ever talks to /api/* (same origin, no CORS change needed).
# Local default below. In production BACKEND_URL MUST be set to the deployed
# FastAPI origin (e.g. https://api.example.com); never localhost. No secrets
# here — only this origin. NEXT_PUBLIC_* must never carry keys or DB URLs.
BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
