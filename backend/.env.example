# Placeholder values only — never real credentials.
# Copy to .env and fill in for local development.
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DATABASE
APP_ENV=local
LOG_LEVEL=INFO
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_STRING_OF_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DOCUMENT_STORAGE_ROOT=./storage/documents
DOCUMENT_MAX_BYTES=26214400
DOCUMENT_MAX_PAGES=200
EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=32
RAG_CHUNK_SIZE=2000
RAG_CHUNK_OVERLAP=256
RAG_TOP_K=8
RAG_MAX_TOP_K=20
RAG_SIMILARITY_THRESHOLD=0.0
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_OUTPUT_TOKENS=1024
GROQ_TEMPERATURE=0.0
AI_MAX_EVIDENCE_ITEMS=10
AI_MAX_EVIDENCE_CHARS=2000
AI_MAX_CONVERSATION_MESSAGES=10
AI_MAX_CONVERSATION_CHARS=12000
# Phase 11: production deployment (Supabase managed PostgreSQL + pgvector).
# Local default: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DATABASE
# Supabase: use the project connection string with SSL enforced, e.g.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# (direct port 5432 for `alembic upgrade head`; pooler port 6543 for the app).
# CORS_ORIGINS: comma-separated explicit frontend origin(s), e.g.
# CORS_ORIGINS=https://app.example.com
# Empty (default) = no CORS middleware (local same-origin proxy needs none).
# "*" is rejected at startup.
CORS_ORIGINS=
# Managed-PostgreSQL pool tuning (defaults preserve historic behavior).
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=10
